# ============================================================
# AI Voice Agent + Frappe CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# DO NOT commit .env to version control.
# ============================================================

# --- Exotel ---
EXOTEL_SID=your_account_sid
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_PHONE=your_exophone_number          # e.g. 08069XXXXXX
EXOTEL_BASE_URL=https://api.in.exotel.com  # Mumbai region

# --- Sarvam AI ---
SARVAM_API_KEY=your_sarvam_subscription_key
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh                     # Bulbul v3 voice name
LLM_MODEL=sarvam-105b-conversations         # Sarvam voice-agent chat model

# --- Frappe CRM ---
FRAPPE_URL=http://localhost:8080
FRAPPE_API_KEY=your_frappe_api_key
FRAPPE_API_SECRET=your_frappe_api_secret

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://voiceagent:secretpassword@localhost:5434/voiceagent

# --- Application ---
SERVER_URL=https://your-ngrok-url.ngrok.io  # Public URL for Exotel callbacks
LOG_LEVEL=INFO
API_AUTH_TOKEN=replace_with_a_long_random_token
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
